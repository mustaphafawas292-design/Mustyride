# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# ===== Database =====
MONGO_URI=mongodb://127.0.0.1:27017/mustyride

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
ADMIN_2FA_ISSUER=MustyRide

# ===== Flutterwave (payments + payouts) =====
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLW_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=set_a_secret_and_put_the_same_value_in_your_flutterwave_dashboard

# ===== SMS / OTP provider =====
# Flutterwave does not send SMS/OTP. You need a separate SMS provider.
# Termii and Africa's Talking both work well for Nigerian numbers.
SMS_PROVIDER=termii
SMS_API_KEY=your_termii_or_africastalking_api_key
SMS_SENDER_ID=MustyRide

# ===== Voice / in-app calling =====
# Used for the "call rider" / "call support" click-to-call feature.
# Africa's Talking Voice or Twilio Voice both work. Placeholder until you pick one.
VOICE_PROVIDER=africastalking
VOICE_API_KEY=your_voice_provider_api_key
VOICE_USERNAME=your_voice_provider_username
SUPPORT_PHONE_NUMBER=+2340000000000

# ===== File uploads (rider documents, complaint photos) =====
# Stored locally under /uploads by default. Swap to Cloudinary/S3 later by
# editing src/middleware/upload.js and src/services/uploadService.js.
UPLOAD_DIR=uploads

# ===== AI Assistant (in-app help widget) =====
# Optional - without this, the assistant runs in a helpful demo mode.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ===== Distance / fare engine =====
# Haversine formula is used by default (no external API key needed).
# You can swap distanceService.js to call Google Distance Matrix later.
DEFAULT_FUEL_PRICE_PER_LITRE=1200
